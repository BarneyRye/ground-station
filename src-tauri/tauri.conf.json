{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seadream Ground Station",
  "version": "../package.json",
  "identifier": "com.barney.ground-station",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seadream Ground Station",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRjE3MTExMTIyRjQwOUQKUldTZFFDOFNFWEh4anFmSE1jMGZOc3U1MFJWMXBuYmNDcmZCSHl6VjFzbGEvRTU4bGZrcEpkcDgK",
      "endpoints": [
        "https://github.com/BarneyRye/ground-station/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
